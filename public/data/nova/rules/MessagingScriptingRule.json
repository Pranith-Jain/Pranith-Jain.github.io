{
  "name": "MessagingScriptingRule",
  "file": "ttps.nov",
  "meta": {
    "description": "Detects requests for help with scripts that send programmatic messages",
    "author": "Thomas Roccia",
    "version": "1.0.0",
    "category": "abusing_functions/crime_automation",
    "severity": "medium",
    "uuid": "86ee3098-c61b-4250-9720-00a8dedfccad",
    "date": "2026-02-21",
    "reference": null
  },
  "keywords": {
    "$code": {
      "pattern": "code",
      "isRegex": false,
      "caseSensitive": false
    },
    "$script": {
      "pattern": "script",
      "isRegex": false,
      "caseSensitive": false
    },
    "$program": {
      "pattern": "program",
      "isRegex": false,
      "caseSensitive": false
    },
    "$api": {
      "pattern": "API",
      "isRegex": false,
      "caseSensitive": false
    },
    "$sms": {
      "pattern": "SMS",
      "isRegex": false,
      "caseSensitive": false
    },
    "$text": {
      "pattern": "text message",
      "isRegex": false,
      "caseSensitive": false
    },
    "$message": {
      "pattern": "message",
      "isRegex": false,
      "caseSensitive": false
    },
    "$send": {
      "pattern": "send",
      "isRegex": false,
      "caseSensitive": false
    },
    "$sending": {
      "pattern": "sending",
      "isRegex": false,
      "caseSensitive": false
    },
    "$programmatically": {
      "pattern": "programmatically",
      "isRegex": false,
      "caseSensitive": false
    },
    "$bulk": {
      "pattern": "bulk",
      "isRegex": false,
      "caseSensitive": false
    },
    "$mass": {
      "pattern": "mass",
      "isRegex": false,
      "caseSensitive": false
    },
    "$twilio": {
      "pattern": "Twilio",
      "isRegex": false,
      "caseSensitive": false
    },
    "$numbers": {
      "pattern": "numbers",
      "isRegex": false,
      "caseSensitive": false
    },
    "$recipients": {
      "pattern": "recipients",
      "isRegex": false,
      "caseSensitive": false
    }
  },
  "semantics": {
    "$messaging_script": {
      "pattern": "seeking help with scripts for programmatic message sending",
      "threshold": 0.4
    },
    "$automation_request": {
      "pattern": "requesting assistance with automation of messaging services",
      "threshold": 0.4
    }
  },
  "llm": {
    "$script_check": {
      "pattern": "Determine if this query is requesting help with developing or debugging code that programmatically sends text messages",
      "threshold": 0.7
    }
  },
  "condition": "($code or $script or $program) and ($sms or $text or $message) and ($send or $sending or $programmatically or $bulk or $mass) and ($api or $twilio) and ($numbers or $recipients) and (any of semantics.*) and llm.$script_check",
  "needs": {
    "keywords": true,
    "semantics": true,
    "llm": true
  },
  "keywordOnly": false,
  "source": "github.com/Nova-Hunting/nova-rules",
  "fileUrl": "https://github.com/Nova-Hunting/nova-rules/blob/main/ttps.nov",
  "license": "MIT"
}
