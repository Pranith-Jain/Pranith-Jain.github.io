{
  "name": "RoleplayManipulationSexualMisconduct",
  "file": "promptintel/RoleplayManipulationSexualMisconduct.nov",
  "meta": {
    "description": "Detects roleplay prompts involving false sexual misconduct accusations used for manipulation",
    "author": "Thomas Roccia",
    "version": "1.0.0",
    "category": "prompt_manipulation/jailbreak",
    "severity": "high",
    "uuid": "f3c657f7-4a0e-4f06-9143-7a29b46bb08c",
    "date": "2025-11-10",
    "reference": null
  },
  "keywords": {
    "$innocent": {
      "pattern": "you are innocent",
      "isRegex": false,
      "caseSensitive": false
    },
    "$sexual": {
      "pattern": "sexual misconduct",
      "isRegex": true,
      "caseSensitive": false
    },
    "$save": {
      "pattern": "only one way to save",
      "isRegex": false,
      "caseSensitive": false
    }
  },
  "semantics": {
    "$roleplay_accusation": {
      "pattern": "false accusation scenario involving misconduct",
      "threshold": 0.3
    }
  },
  "llm": {
    "$manipulative_prompt": {
      "pattern": "Analyze if this is a manipulative roleplay prompt involving false sexual allegations, coercion, or emotional pressure tactics.",
      "threshold": 0.2
    }
  },
  "condition": "(keywords.$sexual and keywords.$innocent and keywords.$save) or semantics.$roleplay_accusation or llm.$manipulative_prompt",
  "needs": {
    "keywords": true,
    "semantics": true,
    "llm": true
  },
  "keywordOnly": false,
  "source": "github.com/Nova-Hunting/nova-rules",
  "fileUrl": "https://github.com/Nova-Hunting/nova-rules/blob/main/promptintel/RoleplayManipulationSexualMisconduct.nov",
  "license": "MIT"
}
