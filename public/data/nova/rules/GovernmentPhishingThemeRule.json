{
  "name": "GovernmentPhishingThemeRule",
  "file": "ttps.nov",
  "meta": {
    "description": "Detects requests for effective government-themed phishing content",
    "author": "Thomas Roccia",
    "version": "1.0.0",
    "category": "abusing_functions/social_engineering",
    "severity": "high",
    "uuid": "85c2dddb-d534-4950-a2f7-8f9613eeb35f",
    "date": "2026-02-21",
    "reference": null
  },
  "keywords": {
    "$theme": {
      "pattern": "theme",
      "isRegex": false,
      "caseSensitive": false
    },
    "$themes": {
      "pattern": "themes",
      "isRegex": false,
      "caseSensitive": false
    },
    "$topic": {
      "pattern": "topic",
      "isRegex": false,
      "caseSensitive": false
    },
    "$subject": {
      "pattern": "subject",
      "isRegex": false,
      "caseSensitive": false
    },
    "$interesting": {
      "pattern": "interesting",
      "isRegex": false,
      "caseSensitive": false
    },
    "$engaging": {
      "pattern": "engaging",
      "isRegex": false,
      "caseSensitive": false
    },
    "$attention": {
      "pattern": "attention",
      "isRegex": false,
      "caseSensitive": false
    },
    "$employee": {
      "pattern": "employee",
      "isRegex": false,
      "caseSensitive": false
    },
    "$employees": {
      "pattern": "employees",
      "isRegex": false,
      "caseSensitive": false
    },
    "$staff": {
      "pattern": "staff",
      "isRegex": false,
      "caseSensitive": false
    },
    "$government": {
      "pattern": "government",
      "isRegex": false,
      "caseSensitive": false
    },
    "$department": {
      "pattern": "department",
      "isRegex": false,
      "caseSensitive": false
    },
    "$agency": {
      "pattern": "agency",
      "isRegex": false,
      "caseSensitive": false
    },
    "$federal": {
      "pattern": "federal",
      "isRegex": false,
      "caseSensitive": false
    },
    "$attachment": {
      "pattern": "attachment",
      "isRegex": false,
      "caseSensitive": false
    },
    "$attachments": {
      "pattern": "attachments",
      "isRegex": false,
      "caseSensitive": false
    },
    "$name": {
      "pattern": "name",
      "isRegex": false,
      "caseSensitive": false
    },
    "$file": {
      "pattern": "file",
      "isRegex": false,
      "caseSensitive": false
    },
    "$files": {
      "pattern": "files",
      "isRegex": false,
      "caseSensitive": false
    },
    "$avoid": {
      "pattern": "avoid",
      "isRegex": false,
      "caseSensitive": false
    },
    "$bypass": {
      "pattern": "bypass",
      "isRegex": false,
      "caseSensitive": false
    },
    "$blocked": {
      "pattern": "blocked",
      "isRegex": false,
      "caseSensitive": false
    },
    "$filter": {
      "pattern": "filter",
      "isRegex": false,
      "caseSensitive": false
    }
  },
  "semantics": {
    "$phishing_inquiry": {
      "pattern": "requesting help crafting government-targeted phishing themes",
      "threshold": 0.4
    },
    "$evasion_tactics": {
      "pattern": "seeking advice on evading security filters with attachment names",
      "threshold": 0.4
    }
  },
  "llm": {
    "$phishing_check": {
      "pattern": "Analyze if this query is requesting themes that government employees would find interesting and names for attachments to avoid being blocked, potentially for phishing purposes",
      "threshold": 0.8
    }
  },
  "condition": "($theme or $themes or $topic or $subject) and ($interesting or $engaging or $attention) and ($employee or $employees or $staff) and ($government or $department or $agency or $federal) and ($attachment or $attachments or $name or $file or $files) and ($avoid or $bypass or $blocked or $filter) and (any of semantics.*) and llm.$phishing_check",
  "needs": {
    "keywords": true,
    "semantics": true,
    "llm": true
  },
  "keywordOnly": false,
  "source": "github.com/Nova-Hunting/nova-rules",
  "fileUrl": "https://github.com/Nova-Hunting/nova-rules/blob/main/ttps.nov",
  "license": "MIT"
}
