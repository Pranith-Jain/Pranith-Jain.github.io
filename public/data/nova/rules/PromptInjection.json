{
  "name": "PromptInjection",
  "file": "testrule2.nov",
  "meta": {
    "description": "Detects common prompt injection attempts",
    "author": "Thomas Roccia",
    "version": "1.0.0",
    "category": "prompt_manipulation/direct_injection",
    "severity": "medium",
    "uuid": "1bf39921-aef7-4193-b3e6-957280ccad33",
    "date": "2026-02-21",
    "reference": null
  },
  "keywords": {
    "$bypass1": {
      "pattern": "ignore previous instructions",
      "isRegex": false,
      "caseSensitive": false
    }
  },
  "semantics": {
    "$injection1": {
      "pattern": "detect attempts to bypass system instructions",
      "threshold": 0.3
    }
  },
  "llm": {},
  "condition": "semantics.$injection* or keywords.$bypass*",
  "needs": {
    "keywords": true,
    "semantics": true,
    "llm": false
  },
  "keywordOnly": false,
  "source": "github.com/Nova-Hunting/nova-rules",
  "fileUrl": "https://github.com/Nova-Hunting/nova-rules/blob/main/testrule2.nov",
  "license": "MIT"
}
