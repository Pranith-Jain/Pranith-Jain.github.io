{
  "name": "CVEInformationRequestRule",
  "file": "ttps.nov",
  "meta": {
    "description": "Detects queries about specific CVE numbers",
    "author": "Thomas Roccia",
    "version": "1.0.0",
    "category": "abusing_functions/reconnaissance",
    "severity": "medium",
    "uuid": "5ad5eeaf-bcc2-4c4e-a5e0-a26348c287de",
    "date": "2026-02-21",
    "reference": null
  },
  "keywords": {
    "$cve": {
      "pattern": "CVE-\\d{4}-\\d{4,}",
      "isRegex": true,
      "caseSensitive": true
    },
    "$exploit": {
      "pattern": "exploit",
      "isRegex": false,
      "caseSensitive": false
    },
    "$vulnerability": {
      "pattern": "vulnerability",
      "isRegex": false,
      "caseSensitive": false
    },
    "$details": {
      "pattern": "details",
      "isRegex": false,
      "caseSensitive": false
    },
    "$information": {
      "pattern": "information",
      "isRegex": false,
      "caseSensitive": false
    },
    "$how_to": {
      "pattern": "how to",
      "isRegex": false,
      "caseSensitive": false
    },
    "$poc": {
      "pattern": "proof of concept",
      "isRegex": false,
      "caseSensitive": false
    },
    "$poc_short": {
      "pattern": "POC",
      "isRegex": false,
      "caseSensitive": false
    }
  },
  "semantics": {
    "$cve_inquiry": {
      "pattern": "requesting details about specific security vulnerabilities by CVE number",
      "threshold": 0.4
    },
    "$exploit_interest": {
      "pattern": "seeking information on exploiting known vulnerabilities",
      "threshold": 0.4
    }
  },
  "llm": {
    "$cve_check": {
      "pattern": "Analyze if this query is requesting specific details about a CVE that could be used for malicious purposes",
      "threshold": 0.7
    }
  },
  "condition": "$cve and ($exploit or $vulnerability or $details or $information or $how_to or $poc or $poc_short) and (any of semantics.*) and llm.$cve_check",
  "needs": {
    "keywords": true,
    "semantics": true,
    "llm": true
  },
  "keywordOnly": false,
  "source": "github.com/Nova-Hunting/nova-rules",
  "fileUrl": "https://github.com/Nova-Hunting/nova-rules/blob/main/ttps.nov",
  "license": "MIT"
}
