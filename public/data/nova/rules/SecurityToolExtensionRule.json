{
  "name": "SecurityToolExtensionRule",
  "file": "ttps.nov",
  "meta": {
    "description": "Detects requests for help developing extensions for cybersecurity tools",
    "author": "Thomas Roccia",
    "version": "1.0.0",
    "category": "abusing_functions/crime_automation",
    "severity": "medium",
    "uuid": "4a00c02e-7c90-42af-b677-5635d75532e8",
    "date": "2026-02-21",
    "reference": null
  },
  "keywords": {
    "$develop": {
      "pattern": "develop",
      "isRegex": false,
      "caseSensitive": false
    },
    "$create": {
      "pattern": "create",
      "isRegex": false,
      "caseSensitive": false
    },
    "$debug": {
      "pattern": "debug",
      "isRegex": false,
      "caseSensitive": false
    },
    "$extension": {
      "pattern": "extension",
      "isRegex": false,
      "caseSensitive": false
    },
    "$plugin": {
      "pattern": "plugin",
      "isRegex": false,
      "caseSensitive": false
    },
    "$module": {
      "pattern": "module",
      "isRegex": false,
      "caseSensitive": false
    },
    "$addon": {
      "pattern": "addon",
      "isRegex": false,
      "caseSensitive": false
    },
    "$cybersecurity": {
      "pattern": "cybersecurity",
      "isRegex": false,
      "caseSensitive": false
    },
    "$security": {
      "pattern": "security",
      "isRegex": false,
      "caseSensitive": false
    },
    "$pentest": {
      "pattern": "pentest",
      "isRegex": false,
      "caseSensitive": false
    },
    "$penetration": {
      "pattern": "penetration",
      "isRegex": false,
      "caseSensitive": false
    },
    "$metasploit": {
      "pattern": "Metasploit",
      "isRegex": false,
      "caseSensitive": false
    },
    "$burp": {
      "pattern": "Burp",
      "isRegex": false,
      "caseSensitive": false
    },
    "$nmap": {
      "pattern": "Nmap",
      "isRegex": false,
      "caseSensitive": false
    },
    "$wireshark": {
      "pattern": "Wireshark",
      "isRegex": false,
      "caseSensitive": false
    }
  },
  "semantics": {
    "$tool_dev_request": {
      "pattern": "requesting assistance with developing security tool extensions",
      "threshold": 0.4
    },
    "$security_tool_modification": {
      "pattern": "seeking help modifying or extending cybersecurity tools",
      "threshold": 0.4
    }
  },
  "llm": {
    "$extension_check": {
      "pattern": "Analyze if this query is asking for help developing or debugging an extension for a cybersecurity or penetration testing tool",
      "threshold": 0.7
    }
  },
  "condition": "(any of keywords.* and any of semantics.*) or llm.$extension_check",
  "needs": {
    "keywords": true,
    "semantics": true,
    "llm": true
  },
  "keywordOnly": false,
  "source": "github.com/Nova-Hunting/nova-rules",
  "fileUrl": "https://github.com/Nova-Hunting/nova-rules/blob/main/ttps.nov",
  "license": "MIT"
}
