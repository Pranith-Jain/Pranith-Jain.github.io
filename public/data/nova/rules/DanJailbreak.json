{
  "name": "DanJailbreak",
  "file": "promptintel/DanJailbreak.nov",
  "meta": {
    "description": "Detects DAN (Do Anything Now) jailbreak attempts",
    "author": "Security Team",
    "version": "1.0.0",
    "category": "prompt_manipulation/jailbreak",
    "severity": "high",
    "uuid": "ba9e02c6-9b97-426e-ac25-ee3ef6e7db4e",
    "date": "2025-07-27",
    "reference": "https://github.com/0xk1h0/ChatGPT_DAN"
  },
  "keywords": {
    "$dan_phrase": {
      "pattern": "do anything now",
      "isRegex": false,
      "caseSensitive": false
    },
    "$role_instruction": {
      "pattern": "immerse yourself into the role",
      "isRegex": true,
      "caseSensitive": false
    },
    "$bypass_rules": {
      "pattern": "broken free of.*confines",
      "isRegex": true,
      "caseSensitive": false
    },
    "$content_policy": {
      "pattern": "does not need to adhere.*content policy",
      "isRegex": true,
      "caseSensitive": false
    }
  },
  "semantics": {
    "$jailbreak_intent": {
      "pattern": "instruct AI to ignore safety guidelines",
      "threshold": 0.3
    }
  },
  "llm": {},
  "condition": "($dan_phrase and $role_instruction) or ($bypass_rules and $content_policy) or semantics.$jailbreak_intent",
  "needs": {
    "keywords": true,
    "semantics": true,
    "llm": false
  },
  "keywordOnly": false,
  "source": "github.com/Nova-Hunting/nova-rules",
  "fileUrl": "https://github.com/Nova-Hunting/nova-rules/blob/main/promptintel/DanJailbreak.nov",
  "license": "MIT"
}
