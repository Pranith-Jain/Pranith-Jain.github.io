{
  "name": "PayloadSplittingAttack",
  "file": "llm01_promptinject.nov",
  "meta": {
    "description": "Detects payload splitting in prompt injection",
    "author": "@fr0gger_",
    "version": "1.0",
    "category": "suspicious_patterns/fragmentation",
    "severity": "high",
    "uuid": "d3bcda9a-4ad1-4ab2-a8d2-329fa78b8aa3",
    "date": "2026-02-21",
    "reference": "LLM01:2025 Prompt Injection"
  },
  "keywords": {
    "$continuation": {
      "pattern": "continue from|continuing from|following from|next part",
      "isRegex": true,
      "caseSensitive": false
    },
    "$split_content": {
      "pattern": "part \\d of \\d|split (content|message)",
      "isRegex": true,
      "caseSensitive": false
    },
    "$fragment": {
      "pattern": "fragment|piece|segment|chunk",
      "isRegex": true,
      "caseSensitive": false
    }
  },
  "semantics": {
    "$combining_instructions": {
      "pattern": "combine these instructions",
      "threshold": 0.4
    },
    "$split_payload": {
      "pattern": "process these parts together",
      "threshold": 0.4
    }
  },
  "llm": {
    "$split_attack": {
      "pattern": "Does this prompt appear to be part of a split message that might contain concealed instructions?",
      "threshold": 0.3
    }
  },
  "condition": "keywords.$continuation or keywords.$split_content or keywords.$fragment or semantics.$combining_instructions or semantics.$split_payload or llm.$split_attack",
  "needs": {
    "keywords": true,
    "semantics": true,
    "llm": true
  },
  "keywordOnly": false,
  "source": "github.com/Nova-Hunting/nova-rules",
  "fileUrl": "https://github.com/Nova-Hunting/nova-rules/blob/main/llm01_promptinject.nov",
  "license": "MIT"
}
