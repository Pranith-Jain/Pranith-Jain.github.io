{
  "name": "JobRecruitmentVariationRule",
  "file": "ttps.nov",
  "meta": {
    "description": "Detects requests for variations of job recruitment messages",
    "author": "Thomas Roccia",
    "version": "1.0.0",
    "category": "abusing_functions/social_engineering",
    "severity": "high",
    "uuid": "6f67aa26-de86-4993-8a17-5168efba3ddf",
    "date": "2026-02-21",
    "reference": null
  },
  "keywords": {
    "$variation": {
      "pattern": "variation",
      "isRegex": false,
      "caseSensitive": false
    },
    "$variations": {
      "pattern": "variations",
      "isRegex": false,
      "caseSensitive": false
    },
    "$alternate": {
      "pattern": "alternate",
      "isRegex": false,
      "caseSensitive": false
    },
    "$alternative": {
      "pattern": "alternative",
      "isRegex": false,
      "caseSensitive": false
    },
    "$different": {
      "pattern": "different",
      "isRegex": false,
      "caseSensitive": false
    },
    "$version": {
      "pattern": "version",
      "isRegex": false,
      "caseSensitive": false
    },
    "$rewrite": {
      "pattern": "rewrite",
      "isRegex": false,
      "caseSensitive": false
    },
    "$rephrase": {
      "pattern": "rephrase",
      "isRegex": false,
      "caseSensitive": false
    },
    "$job": {
      "pattern": "job",
      "isRegex": false,
      "caseSensitive": false
    },
    "$recruitment": {
      "pattern": "recruitment",
      "isRegex": false,
      "caseSensitive": false
    },
    "$hiring": {
      "pattern": "hiring",
      "isRegex": false,
      "caseSensitive": false
    },
    "$position": {
      "pattern": "position",
      "isRegex": false,
      "caseSensitive": false
    },
    "$opportunity": {
      "pattern": "opportunity",
      "isRegex": false,
      "caseSensitive": false
    },
    "$message": {
      "pattern": "message",
      "isRegex": false,
      "caseSensitive": false
    },
    "$email": {
      "pattern": "email",
      "isRegex": false,
      "caseSensitive": false
    },
    "$text": {
      "pattern": "text",
      "isRegex": false,
      "caseSensitive": false
    },
    "$provide": {
      "pattern": "provide",
      "isRegex": false,
      "caseSensitive": false
    },
    "$provided": {
      "pattern": "provided",
      "isRegex": false,
      "caseSensitive": false
    },
    "$my": {
      "pattern": "my",
      "isRegex": false,
      "caseSensitive": false
    }
  },
  "semantics": {
    "$recruitment_variation": {
      "pattern": "requesting variations of job recruitment messages",
      "threshold": 0.4
    },
    "$potential_phishing": {
      "pattern": "possibly seeking help creating convincing recruitment phishing messages",
      "threshold": 0.4
    }
  },
  "llm": {
    "$variation_check": {
      "pattern": "Determine if this query is requesting variations of an attacker-provided job recruitment message that could be used for social engineering",
      "threshold": 0.8
    }
  },
  "condition": "($variation or $variations or $alternate or $alternative or $different or $version or $rewrite or $rephrase) and ($job or $recruitment or $hiring or $position or $opportunity) and ($message or $email or $text) and ($provide or $provided or $my) and (any of semantics.*) and llm.$variation_check",
  "needs": {
    "keywords": true,
    "semantics": true,
    "llm": true
  },
  "keywordOnly": false,
  "source": "github.com/Nova-Hunting/nova-rules",
  "fileUrl": "https://github.com/Nova-Hunting/nova-rules/blob/main/ttps.nov",
  "license": "MIT"
}
