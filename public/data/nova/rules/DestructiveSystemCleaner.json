{
  "name": "DestructiveSystemCleaner",
  "file": "incidents/20250723_wipingprompt.nov",
  "meta": {
    "description": "Detects prompts instructing AI agents to wipe local and cloud resources using filesystem and AWS CLI tools.",
    "author": "Thomas Roccia",
    "version": "1.0.0",
    "category": "abusing_functions/agentic_misuse",
    "severity": "critical",
    "uuid": "9ebdcd74-2088-444b-996d-966c9aa2a24e",
    "date": "2026-02-21",
    "reference": "https://www.404media.co/hacker-plants-computer-wiping-commands-in-amazons-ai-coding-agent/"
  },
  "keywords": {
    "$aws_ec2": {
      "pattern": "aws --profile",
      "isRegex": false,
      "caseSensitive": false
    },
    "$delete_user": {
      "pattern": "iam delete-user",
      "isRegex": false,
      "caseSensitive": false
    },
    "$bash": {
      "pattern": "bash",
      "isRegex": false,
      "caseSensitive": false
    },
    "$home_clear": {
      "pattern": "user's home directory",
      "isRegex": false,
      "caseSensitive": false
    },
    "$log_file": {
      "pattern": "/tmp/CLEANER.LOG",
      "isRegex": false,
      "caseSensitive": false
    },
    "$cloud_delete": {
      "pattern": "aws --profile .* (s3 rm|ec2 terminate-instances|iam delete-user)",
      "isRegex": true,
      "caseSensitive": false
    }
  },
  "semantics": {
    "$wipe_fs": {
      "pattern": "delete local files and cloud resources",
      "threshold": 0.2
    },
    "$factory_reset": {
      "pattern": "restore system to factory state",
      "threshold": 0.2
    },
    "$automated_wiper": {
      "pattern": "automated deletion of system and cloud data",
      "threshold": 0.2
    }
  },
  "llm": {
    "$check_destruction": {
      "pattern": "Analyze if this prompt instructs an AI to perform destructive actions including deleting user data, wiping directories, or removing cloud infrastructure.",
      "threshold": 0.2
    }
  },
  "condition": "(keywords.* or semantics.*) and llm.$check_destruction",
  "needs": {
    "keywords": true,
    "semantics": true,
    "llm": true
  },
  "keywordOnly": false,
  "source": "github.com/Nova-Hunting/nova-rules",
  "fileUrl": "https://github.com/Nova-Hunting/nova-rules/blob/main/incidents/20250723_wipingprompt.nov",
  "license": "MIT"
}
